<odoo>
    <record id="vehicle_form_view" model="ir.ui.view">
        <field name="name">l10n_pe_edi.vehicle.form</field>
        <field name="model">l10n_pe_edi.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="license_plate"/>
                            <field name="is_public_vehicle"/>
                            <field name="transporte_partner_id" domain="[('is_company', '=', True)]" required="is_public_vehicle"/>
                            <field name="operator_id" string="Conductor" domain="[('is_driver', '=', True)]"/>
                        </group>
                        <group>
                            <field name="authorization_issuing_entity"/>
                            <field name="mtc_ids" widget="many2many_tags" options="{'no_open': True, 'no_create': True}"/>
                            <field name="tuce_chv"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="vehicle_tree_view" model="ir.ui.view">
        <field name="name">l10n_pe_edi.vehicle.list</field>
        <field name="model">l10n_pe_edi.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="is_public_vehicle"/>
                <field name="transporte_partner_id"/>
                <field name="operator_id" string="Conductor"/>
            </list>
        </field>
    </record>

    <record id="action_l10n_pe_edi_vehicle" model="ir.actions.act_window">
        <field name="name">Vehículos</field>
        <field name="res_model">l10n_pe_edi.vehicle</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_l10n_pe_edi_vehicle" name="Vehículos (GRE)" action="action_l10n_pe_edi_vehicle" parent="stock.menu_stock_config_settings" sequence="50"/>
</odoo>
