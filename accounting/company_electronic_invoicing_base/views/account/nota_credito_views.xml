<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_account_move_reversal" model="ir.ui.view">
        <field name="name">Wizard - Nota de crédito</field>
        <field name="model">account.move.reversal</field>
        <field name="inherit_id" ref="account.view_account_move_reversal"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="tipo_comprobante_a_rectificar" invisible="1"/>
                <field name="journal_type" invisible="1"/>
                <field name="l10n_pe_edi_refund_reason" required="country_code == 'PE'"/>
            </xpath>
            <field name="reason" position="attributes">
                <attribute name="required">1</attribute>
            </field>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="domain">[('invoice_type_code', '=', '07'), ('tipo_comprobante_a_rectificar', '=', tipo_comprobante_a_rectificar),('type', '=', journal_type)]</attribute>
                <attribute name="options">{'no_create': True, 'no_open': True}</attribute>
                <attribute name="required">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_credit_note" model="ir.actions.act_window">
        <field name="name">Nota de Crédito</field>
        <field name="res_model">account.move</field>
        <field name="view_id" ref="company_electronic_invoicing_base.account_factura_tree_1"/>
        <field name="view_mode">list,kanban,form,pivot,graph</field>
        <field name="context">
            {
                'default_move_type':'out_refund',
                'default_journal_type': 'sale',
                'default_invoice_type_code':'07',
                'default_payment_term_id':1,
                'create': False
            }
        </field>
        <field name="domain"> [('move_type', '=', 'out_refund'),('journal_id.invoice_type_code', '=', '07')]
        </field>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
    </record>
</odoo>
