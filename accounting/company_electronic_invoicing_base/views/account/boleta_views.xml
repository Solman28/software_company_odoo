<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_move_out_boleta" model="ir.actions.act_window">
        <field name="name">Boleta de Venta</field>
        <field name="path">sale_receipt</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,kanban,form,activity</field>
        <field name="view_id" ref="account_factura_tree_1"/>
        <field name="search_view_id" ref="account.view_account_invoice_filter"/>
        <field name="context">
            {
                'default_move_type':'out_invoice',
                'default_journal_type': 'sale',
                'default_invoice_type_code':'03',
            }
        </field>
        <field name="domain"> [('move_type','=','out_invoice'), ('journal_id.invoice_type_code','=','03')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear una boleta de venta
            </p><p>
                Crea boletas, registra pagos y realiza un seguimiento de las conversaciones con tus clientes.
            </p>
        </field>
    </record>
</odoo>
