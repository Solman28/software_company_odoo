<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_factura_tree_1" model="ir.ui.view">
            <field name="name">account.factura.tree</field>
            <field name="model">account.move</field>
            <field name="arch" type="xml">
                <list js_class="account_tree">
                    <header>
                        <button name="action_force_register_payment" type="object" string="Pagar"
                            groups="account.group_account_invoice"
                            invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt', 'in_invoice', 'in_refund','in_receipt')"/>
                        <button name="action_send_and_print" type="object" string="Enviar"/>
                    </header>
                    <field name="partner_id" groups="base.group_user" string="Cliente"/>
                    <field name="name" string="Número"/>
                    <field name="invoice_date" optional="show" readonly="state != 'draft'" string="Fecha de factura" decoration-warning="abnormal_date_warning"/>
                    <field name="date" optional="hide" string="Fecha contable" readonly="state in ['cancel', 'posted']"/>
                    <field name="invoice_date_due" widget="remaining_days" optional="show" invisible="payment_state in ('paid', 'in_payment', 'reversed') or state == 'cancel'"/>
                    <field name="reversed_entry_id" string="Ref. Crédito" optional="show" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')"/>
                    <!-- <field name="debit_origin_id" string="Ref. Débito" optional="show"/> -->
                    <!-- <field name="payment_state" string="Estado de pago"/> -->
                    <field name="journal_id" column_invisible="1"/>
                    <field name="invoice_origin" optional="hide" string="Doc. Origen"/>
                    <field name="invoice_user_id" optional="hide" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')" string="Vendedor" widget="many2one_avatar_user"/>
                    <field name="team_id" string="Equipo de ventas" column_invisible="context.get('default_move_type') not in ('out_invoice', 'out_refund', 'out_receipt')" optional="hide"/>
                    <field name="activity_ids" widget="list_activity" optional="hide"/>
                    <field name="amount_untaxed_in_currency_signed" string="Impuestos no incluidos" sum="Total" optional="show"/>
                    <field name="amount_tax_signed" string="Impuesto" sum="Total" optional="hide"/>
                    <field name="amount_total_in_currency_signed" string="Total" sum="Total" optional="show" decoration-bf="1" decoration-warning="abnormal_amount_warning" groups="base.group_multi_currency"/>
                    <field name="amount_total_in_currency_signed" string="Total" sum="Total" optional="hide" decoration-bf="1" decoration-warning="abnormal_amount_warning" groups="!base.group_multi_currency"/>
                    <field name="amount_residual_signed" string="Monto adeudado" sum="Por pagar" optional="hide"/>
                    <field name="currency_id" optional="hide" readonly="state in ['cancel', 'posted']" string="Moneda"/>
                    <field name="company_currency_id" column_invisible="True"/>
                    <!-- <field name="amount_total_signed" string="Total"/> -->
                    <field name="estado_emision" optional="show"
                        widget="badge"
                        decoration-info="estado_emision in ('E', 'N', 'P')"
                        decoration-success="estado_emision == 'A'"
                        decoration-warning="estado_emision == 'O'"
                        decoration-danger="estado_emision == 'R'"/>
                    <!-- <field name="estado_comprobante_electronico" 
                            string="Validez"
                            widget="badge"
                            decoration-info="estado_comprobante_electronico == '3_AUTORIZADO'"
                            decoration-success="estado_comprobante_electronico == '1_ACEPTADO'"
                            decoration-warning="estado_comprobante_electronico in ('0_NO_EXISTE', '4_NO_AUTORIZADO')"
                            decoration-danger="estado_comprobante_electronico == '2_ANULADO'"
                            optional="hide"
                    /> -->
                    <field name="status_in_payment"
                           string="Estado"
                           widget="badge"
                           decoration-info="state == 'draft'"
                           decoration-danger="payment_state == 'not_paid' and invoice_date_due &lt; context_today().strftime('%Y-%m-%d')"
                           decoration-warning="payment_state in ('partial', 'in_payment')"
                           decoration-success="payment_state in ('paid', 'reversed')"
                           invisible="payment_state == 'invoicing_legacy' or move_type == 'entry'"
                           optional="show"
                    />
                    <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}" optional="hide"/>
                    <field name="company_id" groups="!base.group_multi_company" column_invisible="True"/>
                    <field name="move_type" column_invisible="context.get('default_move_type', True)"/>
                    <field name="abnormal_amount_warning" column_invisible="1"/>
                    <field name="abnormal_date_warning" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_invoice_tree_inherit_fe" model="ir.ui.view">
            <field name="name">view.invoice.tree.inherit.fe</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_out_invoice_tree"/>
            <field name="arch" type="xml">
                <field name='invoice_date_due' position="after">
                    <field name="reversed_entry_id" string="Ref. Crédito" optional="show"/>
                </field>
                <field name="status_in_payment" position="after">
                    <field name="estado_emision" optional="show"
                        widget="badge"
                        decoration-info="estado_emision in ('E', 'N', 'P')"
                        decoration-success="estado_emision == 'A'"
                        decoration-warning="estado_emision == 'O'"
                        decoration-danger="estado_emision == 'R'"/>
                    <!-- <field name="estado_comprobante_electronico" 
                            string="Validez"
                            widget="badge"
                            decoration-info="estado_comprobante_electronico == '3_AUTORIZADO'"
                            decoration-success="estado_comprobante_electronico == '1_ACEPTADO'"
                            decoration-warning="estado_comprobante_electronico in ('0_NO_EXISTE', '4_NO_AUTORIZADO')"
                            decoration-danger="estado_comprobante_electronico == '2_ANULADO'"
                            optional="hide"/> -->
                </field>
            </field>
        </record>
        
        <record id="account.action_move_out_invoice" model="ir.actions.act_window">
            <field name="name">Customer Invoices</field>
            <field name="context">{'default_move_type': 'out_invoice', 'create': 0}</field>
            <field name="help">En esta sección podrás visualizar la lista de comprobantes de venta creados.</field>
        </record>

        <record id="account.menu_action_move_out_invoice_type" model="ir.ui.menu">
            <field name="name">Customer Invoices</field>
        </record>

        <record id="action_move_out_factura" model="ir.actions.act_window">
            <field name="name">Facturas</field>
            <field name="path">sale_invoicing</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,activity</field>
            <field name="view_id" ref="account_factura_tree_1"/>
            <field name="context">
                {
                    'default_move_type': 'out_invoice',
                    'default_journal_type': 'sale',
                    'default_invoice_type_code':'01',
                }
            </field>
            <field name="domain"> [('move_type','=','out_invoice'), ('journal_id.invoice_type_code','=','01')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Crear una factura de cliente
                </p><p>
                    Crea facturas, registra pagos y realiza un seguimiento de las conversaciones con tus clientes.
                </p>
            </field>
        </record>

        <record id="account.action_move_in_invoice" model="ir.actions.act_window">
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,activity</field>
            <field name="context" eval="{'search_default_in_invoice': 1, 'default_move_type': 'in_invoice', 'display_account_trust': True, 'default_journal_type': 'purchase', 'default_invoice_type_code':'01'}"/>
        </record>
        
        <!-- <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
            <field name="res_model">account.move</field>
            <field name="view_mode">list,kanban,form,activity</field>
            <field name="context" eval="{'default_move_type':'in_invoice', 'display_account_trust': True, 'default_journal_type': 'purchase', 'default_invoice_type_code':'01'}"/>
        </record> -->
    </data>
</odoo>
