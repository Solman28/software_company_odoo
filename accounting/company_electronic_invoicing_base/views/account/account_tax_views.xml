<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_tax_form_pe_edi" model="ir.ui.view">
        <field name="name">account.tax.form.pe.edi</field>
        <field name="model">account.tax</field>
        <field name="inherit_id" ref="account.view_tax_form"/>
        <field name="arch" type="xml">
            <field name="tax_group_id" position="after">
                <field name="l10n_pe_edi_affectation_reason"/>
                <field name="l10n_pe_edi_tax_code"/>
            </field>
        </field>
    </record>

    <record id="view_tax_group_form_pe_edi" model="ir.ui.view">
        <field name="name">account.tax.group.form.pe.edi</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_form"/>
        <field name="arch" type="xml">
            <field name="sequence" position="after">
                <field name="l10n_pe_edi_code" string="Código EDI"/>
            </field>
        </field>
    </record>

    <record id="view_tax_group_tree_pe_edi" model="ir.ui.view">
        <field name="name">account.tax.group.list.pe.edi</field>
        <field name="model">account.tax.group</field>
        <field name="inherit_id" ref="account.view_tax_group_tree"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="l10n_pe_edi_code" string="Código EDI"/>
            </field>
        </field>
    </record>
</odoo>
