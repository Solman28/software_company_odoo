<odoo>
    <data>
        <record id="view_picking_form_guide" model="ir.ui.view">
            <field name="name">view.picking.form.guide</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='extra']//group[@name='other_infos']" position="inside">
                    <field name="l10n_pe_edi_transport_type"/>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_guia_remision_remitente" class="oe_stat_button" type="object" icon="fa-truck" invisible="guia_remision_remitente_count == 0">
                        <field name="guia_remision_remitente_count" string="GRER" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button" type="object" name="action_view_guia_remision_transportista" icon="fa-truck" invisible="guia_remision_transportista_count == 0">
                        <field name="guia_remision_transportista_count" string="GRET" widget="statinfo"/>
                    </button>
                </xpath>
                <xpath expr="//header//button[@name='action_cancel']" position="after">
                    <field name="hide_grr_button" invisible="1"/>
                    <button name="action_generate_gre_remitente" type="object" string="Generar GRE Remitente" class="oe_highlight" invisible="state in ('draft', 'cancel') or hide_grr_button" confirm="¿Estás seguro(a) de generar una GRE Remitente?"/>
                    <button name="action_generate_gre_transportista" type="object" string="Generar GRE Transportista" class="oe_highlight" invisible="state in ('draft', 'cancel') or hide_grt_button" confirm="¿Estás seguro(a) de generar una GRE Transportista?"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>