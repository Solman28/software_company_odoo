<odoo>
    <data>
        <record model="ir.ui.view" id="view_stock_warehouse_form_inherit">
            <field name="name">view.warehouse.form.suitable.journals</field>
            <field name="model">stock.warehouse</field>
            <field name="inherit_id" ref="stock.view_warehouse"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="journal_ids" widget="many2many_tags" options="{'no_create': True, 'no_open': True}" 
                        domain="[('type','in',['sale','purchase'])]"/>
                </xpath>
            </field>
        </record>
        <record model="ir.ui.view" id="view_picking_type_form_need_gre">
            <field name="name">view.picking.type.form.need.gre</field>
            <field name="model">stock.picking.type</field>
            <field name="inherit_id" ref="stock.view_picking_type_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='sequence_code']" position="after">
                    <field name="need_gre" invisible="code != 'outgoing'"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>