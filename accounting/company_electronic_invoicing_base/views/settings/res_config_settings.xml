<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_retention_setting" model="ir.ui.view">
        <field name="name">Configuracion para retenciones</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='account_digitalization']" position="after">
                <block title="Retenciones" id="account_retention">
                    <setting id="retention_config" string="Configuración de cuentas" help="Las siguientes cuentas predeterminadas se utilizan con determinadas funciones de retención.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="retention_journal_id" class="col-lg-5 o_light_label"/>
                                <field name="retention_journal_id" options="{'no_create':True}"/>
                            </div>
                            <div class="row mt8">
                                <label for="retention_account_id" class="col-lg-5 o_light_label"/>
                                <field name="retention_account_id" options="{'no_create':True}"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
